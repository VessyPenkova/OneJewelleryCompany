@model OneJevelsCompany.Web.Models.Admin.DashboardVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="space-y-6">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3">
        <div>
            <h1 class="text-3xl font-bold text-gray-800">Dashboard</h1>
            <p class="text-sm text-gray-500 mt-1">Overview of sales, status, and recent activity.</p>
        </div>
        <div class="text-sm text-gray-400">
            @DateTime.Now.ToString("dddd, dd MMM yyyy")
        </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">
            <div class="flex items-center justify-between">
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wide">Total Sales</div>
                <span class="h-3 w-3 rounded-full bg-amber-400"></span>
            </div>
            <div class="mt-4 text-3xl font-bold text-gray-800">@Model.TotalSales.ToString("C")</div>
        </div>

        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">
            <div class="flex items-center justify-between">
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wide">Today</div>
                <span class="h-3 w-3 rounded-full bg-green-400"></span>
            </div>
            <div class="mt-4 text-3xl font-bold text-gray-800">@Model.TodaysSales.ToString("C")</div>
        </div>

        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">
            <div class="flex items-center justify-between">
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wide">Not Initiated</div>
                <span class="h-3 w-3 rounded-full bg-rose-300"></span>
            </div>
            <div class="mt-4 text-3xl font-bold text-gray-800">@Model.NotInitiatedValue.ToString("C")</div>
        </div>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-800">Sales Variance (30 days)</h3>
                <span class="text-xs text-gray-400">Actual vs Forecast</span>
            </div>

            @if (Model.Variances?.Any() == true)
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full text-left">
                        <thead class="text-sm text-gray-500 border-b border-gray-200">
                            <tr>
                                <th class="py-2 pr-4 font-semibold">Category</th>
                                <th class="py-2 pr-4 font-semibold">Actual</th>
                                <th class="py-2 font-semibold">Forecast</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Variances)
                            {
                                <tr class="border-b border-gray-100 hover:bg-gray-50 transition">
                                    <td class="py-3 pr-4 text-gray-800">@v.Category</td>
                                    <td class="py-3 pr-4 font-medium text-gray-900">@v.Actual.ToString("C")</td>
                                    <td class="py-3 text-gray-600">@v.Forecast.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="rounded-xl border border-dashed border-gray-200 bg-gray-50 px-4 py-10 text-center">
                    <div class="text-sm font-medium text-gray-500">No sales variance data yet.</div>
                    <div class="text-xs text-gray-400 mt-1">Paid orders will appear here automatically.</div>
                </div>
            }
        </div>

        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-800">Recent Milestones</h3>
                <span class="text-xs text-gray-400">Latest updates</span>
            </div>

            @if (Model.Milestones?.Any() == true)
            {
                <ul class="space-y-3">
                    @foreach (var m in Model.Milestones)
                    {
                        <li class="border border-gray-200 rounded-xl p-3 hover:bg-gray-50 transition">
                            <div class="font-medium text-gray-800">@m.Title</div>
                            <div class="text-xs text-gray-500 mt-1">@m.When.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="rounded-xl border border-dashed border-gray-200 bg-gray-50 px-4 py-10 text-center">
                    <div class="text-sm font-medium text-gray-500">No recent milestones.</div>
                </div>
            }
        </div>
    </div>
</div>