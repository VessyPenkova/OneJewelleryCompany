@model IEnumerable<OneJevelsCompany.Core.Entities.Jewel>
@using OneJevelsCompany.Web.Models
@{
    ViewData["Title"] = "Collections";
    var selected = (JewelCategory?)(ViewBag.SelectedCategory ?? null);
}

<section class="catalog-header">
    <div>
        <div class="eyebrow">The collection</div>
        <h1>Find your piece</h1>
        <p>Ready-to-wear jewellery, selected for timeless everyday style.</p>
    </div>
    <div class="filter-pills">
        <a asp-action="Collections" asp-route-category="Necklace" class="filter-pill @(selected == JewelCategory.Necklace ? "active" : "")">Necklaces</a>
        <a asp-action="Collections" asp-route-category="Bracelet" class="filter-pill @(selected == JewelCategory.Bracelet ? "active" : "")">Bracelets</a>
    </div>
</section>

@if (!Model.Any())
{
    <div class="panel p-12 text-center text-gray-500">No pieces are available in this selection yet.</div>
}
else
{
    <div class="product-grid">
        @foreach (var j in Model)
        {
            <article class="product-card">
                <div class="product-image">
                    @if (!string.IsNullOrWhiteSpace(j.ImageUrl))
                    {
                        <img src="@j.ImageUrl" alt="@j.Name" />
                    }
                    else
                    {
                        <span class="product-placeholder">◇</span>
                    }
                </div>
                <div class="product-body">
                    <div class="product-meta"><span>@j.Category</span><span>@j.QuantityOnHand in stock</span></div>
                    <h3>@j.Name</h3>
                    <div class="product-price">@j.TotalPrice().ToString("C")</div>
                    <form asp-controller="Shop" asp-action="AddReady" method="post" class="product-buy">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@j.Id" />
                        <input name="qty" type="number" min="1" max="@j.QuantityOnHand" value="1" aria-label="Quantity" />
                        <button type="submit">Add to bag</button>
                    </form>
                </div>
            </article>
        }
    </div>
}
