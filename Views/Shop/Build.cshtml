@model IEnumerable<OneJevelsCompany.Web.Models.Component>
@using OneJevelsCompany.Web.Models
@{
    ViewData["Title"] = "Build Your Own Jewellery";
    var category = (JewelCategory)ViewBag.Category;
    var pieceName = category.ToString();
    var pieceNameLower = pieceName.ToLowerInvariant();
}

<div class="max-w-6xl mx-auto space-y-6">
    <!-- Clear introduction: intentionally no portrait/background image -->
    <section class="rounded-2xl border border-amber-200 bg-white overflow-hidden shadow-sm">
        <div class="px-6 py-7 md:px-9 md:py-9">
            <div class="text-xs uppercase tracking-[0.24em] text-amber-700 font-semibold">Your jewellery, your design</div>
            <div class="mt-2 grid lg:grid-cols-[1fr_auto] gap-7 items-end">
                <div>
                    <h1 class="text-3xl md:text-4xl font-semibold text-gray-900">Build Your Own Jewellery</h1>
                    <p class="mt-3 max-w-2xl text-gray-600 leading-7">
                        Choose the type of jewellery, select the components you want in one piece, and see the estimated price as you build.
                    </p>
                </div>
                <a asp-controller="Shop" asp-action="Design"
                   class="inline-flex items-center justify-center gap-2 rounded-xl bg-gray-900 px-5 py-3 text-white font-medium hover:bg-gray-800 transition">
                    <span aria-hidden="true">◇</span>
                    Open 3D Design Studio
                </a>
            </div>
        </div>

        <div class="border-t bg-amber-50/50 px-6 py-4 md:px-9">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
                <div class="flex items-center gap-2"><span class="grid h-7 w-7 place-items-center rounded-full bg-amber-700 text-white text-xs font-semibold">1</span><span class="font-medium">Choose type</span></div>
                <div class="flex items-center gap-2"><span class="grid h-7 w-7 place-items-center rounded-full bg-amber-700 text-white text-xs font-semibold">2</span><span class="font-medium">Choose parts</span></div>
                <div class="flex items-center gap-2"><span class="grid h-7 w-7 place-items-center rounded-full bg-amber-700 text-white text-xs font-semibold">3</span><span class="font-medium">Review price</span></div>
                <div class="flex items-center gap-2"><span class="grid h-7 w-7 place-items-center rounded-full bg-amber-700 text-white text-xs font-semibold">4</span><span class="font-medium">Add to cart</span></div>
            </div>
        </div>
    </section>

    <!-- Step 1 -->
    <section class="bg-white rounded-2xl border shadow-sm p-6 md:p-7">
        <div class="flex items-start justify-between gap-4 mb-5">
            <div>
                <div class="text-xs uppercase tracking-wider text-amber-700 font-semibold">Step 1</div>
                <h2 class="text-xl font-semibold text-gray-900 mt-1">What would you like to create?</h2>
                <p class="text-sm text-gray-600 mt-1">Choose a jewellery type. Your component choices will appear below.</p>
            </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4 max-w-2xl">
            <a href="/Shop/Build?category=Necklace"
               class="rounded-xl border-2 p-5 transition @(category == JewelCategory.Necklace ? "border-amber-600 bg-amber-50" : "border-gray-200 hover:border-amber-300")">
                <div class="flex items-center gap-4">
                    <div class="grid h-12 w-12 place-items-center rounded-full border border-amber-300 bg-white text-2xl text-amber-700">○</div>
                    <div>
                        <div class="font-semibold text-lg text-gray-900">Necklace</div>
                        <div class="text-sm text-gray-500">Build from chains, clasps, pendants and available parts.</div>
                    </div>
                    @if (category == JewelCategory.Necklace)
                    {
                        <span class="ml-auto text-amber-700 font-semibold">Selected</span>
                    }
                </div>
            </a>

            <a href="/Shop/Build?category=Bracelet"
               class="rounded-xl border-2 p-5 transition @(category == JewelCategory.Bracelet ? "border-amber-600 bg-amber-50" : "border-gray-200 hover:border-amber-300")">
                <div class="flex items-center gap-4">
                    <div class="grid h-12 w-12 place-items-center rounded-full border border-amber-300 bg-white text-2xl text-amber-700">◌</div>
                    <div>
                        <div class="font-semibold text-lg text-gray-900">Bracelet</div>
                        <div class="text-sm text-gray-500">Combine available components into your own bracelet.</div>
                    </div>
                    @if (category == JewelCategory.Bracelet)
                    {
                        <span class="ml-auto text-amber-700 font-semibold">Selected</span>
                    }
                </div>
            </a>
        </div>
    </section>

    <form asp-controller="Cart" asp-action="AddCustomRecipe" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Category" value="@((int)category)" />

        <!-- Step 2 -->
        <section class="bg-white rounded-2xl border shadow-sm p-6 md:p-7">
            <div class="mb-6">
                <div class="text-xs uppercase tracking-wider text-amber-700 font-semibold">Step 2</div>
                <h2 class="text-xl font-semibold text-gray-900 mt-1">Build your @pieceNameLower</h2>
                <p class="text-sm text-gray-600 mt-1">
                    Use + and − to choose how many of each component are used in <strong>one @pieceNameLower</strong>. Leave a component at 0 if you do not want to use it.
                </p>
            </div>

            @foreach (var group in Model
                .GroupBy(c => new { Name = c.Category?.Name ?? "Other", Order = c.Category?.SortOrder ?? 999 })
                .OrderBy(g => g.Key.Order))
            {
                <div class="mb-7 last:mb-0">
                    <div class="flex items-center gap-3 mb-3">
                        <h3 class="text-base font-semibold text-gray-900">@group.Key.Name</h3>
                        <div class="h-px flex-1 bg-gray-200"></div>
                    </div>

                    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        @foreach (var c in group.OrderBy(x => x.Name))
                        {
                            var outOfStock = c.QuantityOnHand <= 0;
                            <article class="component-card relative rounded-xl border bg-white p-4 transition hover:shadow-md @(outOfStock ? "opacity-60" : "")">
                                <div class="flex gap-3">
                                    <div class="h-16 w-16 shrink-0 rounded-lg border bg-gray-50 overflow-hidden grid place-items-center">
                                        @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                                        {
                                            <img src="@c.ImageUrl" alt="@c.Name" class="h-full w-full object-contain" />
                                        }
                                        else
                                        {
                                            <span class="text-2xl text-amber-700" aria-hidden="true">◇</span>
                                        }
                                    </div>

                                    <div class="min-w-0 flex-1">
                                        <div class="component-name font-semibold text-gray-900 leading-5" title="@c.Name">@c.Name</div>
                                        <div class="mt-1 text-xs leading-5 text-gray-500">
                                            @if (!string.IsNullOrEmpty(c.Color)) { <span>@c.Color · </span> }
                                            @if (!string.IsNullOrEmpty(c.SizeLabel)) { <span>@c.SizeLabel · </span> }
                                            @if (!string.IsNullOrEmpty(c.Dimensions)) { <span>@c.Dimensions · </span> }
                                            <span>@c.Price.ToString("C")</span>
                                        </div>
                                        <div class="text-xs @(outOfStock ? "text-red-600" : "text-gray-500")">
                                            @(outOfStock ? "Out of stock" : $"{c.QuantityOnHand} available")
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4 flex items-end justify-between gap-3">
                                    <div>
                                        <label for="qty-@c.Id" class="block text-xs font-medium text-gray-600 mb-1">Quantity in one piece</label>
                                        <div class="flex items-center gap-2">
                                            <button type="button" class="step-btn h-9 w-9 rounded-lg border text-gray-700 hover:bg-gray-50" data-dir="-1" data-for="qty-@c.Id" aria-label="Decrease @c.Name">−</button>
                                            <input id="qty-@c.Id" type="number" min="0" value="0"
                                                   name="Components[@c.Id].Quantity" data-price="@c.Price"
                                                   class="qty-input h-9 w-16 rounded-lg border text-center"
                                                   @(outOfStock ? "disabled" : "") />
                                            <button type="button" class="step-btn h-9 w-9 rounded-lg border text-gray-700 hover:bg-gray-50" data-dir="1" data-for="qty-@c.Id" aria-label="Increase @c.Name">+</button>
                                        </div>
                                    </div>
                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@c.Id" class="text-sm text-amber-800 hover:underline">Details</a>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }
        </section>

        <!-- Step 3 -->
        <section class="grid lg:grid-cols-[1fr_360px] gap-6 items-start">
            <div class="bg-white rounded-2xl border shadow-sm p-6 md:p-7">
                <div class="text-xs uppercase tracking-wider text-amber-700 font-semibold">Step 3</div>
                <h2 class="text-xl font-semibold text-gray-900 mt-1">Name and review your design</h2>
                <p class="text-sm text-gray-600 mt-1 mb-5">Give your design a name and check the selected components before adding it to your cart.</p>

                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">Design name</label>
                        <input name="DesignName" maxlength="80" class="w-full border rounded-lg p-2.5" placeholder="e.g. Golden Evening" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Finished quantity</label>
                        <input name="Quantity" type="number" min="1" value="1" class="w-full border rounded-lg p-2.5" />
                    </div>
                </div>

                <div class="mt-5">
                    <div class="text-sm font-semibold text-gray-700 mb-2">Your selected components</div>
                    <div id="preview" class="flex flex-wrap gap-2"></div>
                </div>
            </div>

            <aside class="bg-gray-900 text-white rounded-2xl shadow-sm p-6 lg:sticky lg:top-24">
                <div class="text-xs uppercase tracking-wider text-amber-200 font-semibold">Design summary</div>
                <div class="mt-4">
                    <div class="text-sm text-gray-300">Creating</div>
                    <div class="text-xl font-semibold">@pieceName</div>
                </div>

                <div class="mt-5 border-t border-white/15 pt-5">
                    <label class="block text-sm text-gray-300 mb-1">Crafting / labor per piece</label>
                    <input name="LaborPerPiece" type="number" step="0.01" min="0" value="10.00"
                           class="w-full rounded-lg border border-white/20 bg-white/10 p-2.5 text-white" />
                </div>

                <div class="mt-5 border-t border-white/15 pt-5 flex items-end justify-between gap-4">
                    <div>
                        <div class="text-sm text-gray-300">Estimated unit price</div>
                        <div class="text-xs text-gray-400 mt-1">Components + crafting</div>
                    </div>
                    <input id="unitPrice" type="text" readonly class="w-32 bg-transparent text-right text-2xl font-semibold text-amber-200 outline-none" value="$0.00" />
                </div>

                <button type="submit" class="mt-6 w-full rounded-xl bg-amber-600 px-6 py-3.5 font-semibold text-white hover:bg-amber-500 transition">
                    Add My Design to Cart
                </button>
                <a asp-controller="Shop" asp-action="Collections" class="mt-3 block text-center text-sm text-gray-300 hover:text-white">Cancel and return to collections</a>
            </aside>
        </section>
    </form>

    <section class="rounded-2xl border border-amber-200 bg-amber-50/60 p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="font-semibold text-gray-900">Want to arrange your design visually?</div>
            <div class="text-sm text-gray-600 mt-1">The existing 3D Design Studio is still available with its sequence and preview tools.</div>
        </div>
        <a asp-controller="Shop" asp-action="Design" class="shrink-0 rounded-lg border border-amber-600 px-4 py-2 text-amber-800 font-medium hover:bg-amber-100">Open 3D Preview</a>
    </section>
</div>

@section Scripts {
    <script>
        function recalcUnitPrice() {
            let materials = 0;
            const chips = [];
            document.querySelectorAll('.qty-input').forEach(inp => {
                if (inp.disabled) return;
                const q = parseInt(inp.value || '0', 10);
                const p = parseFloat(inp.dataset.price || '0');
                if (!isNaN(q) && !isNaN(p) && q > 0) {
                    materials += q * p;
                    const card = inp.closest('.component-card');
                    const name = card ? card.querySelector('.component-name').textContent.trim() : 'Component';
                    chips.push(`${q}× ${name}`);
                }
            });

            const laborInput = document.querySelector('input[name=LaborPerPiece]');
            const labor = parseFloat(laborInput ? laborInput.value || '0' : '0');
            const unit = materials + (isNaN(labor) ? 0 : labor);
            document.getElementById('unitPrice').value = unit.toLocaleString(undefined, { style: 'currency', currency: 'USD' });

            const prev = document.getElementById('preview');
            prev.innerHTML = '';
            chips.forEach(t => {
                const span = document.createElement('span');
                span.className = 'inline-flex items-center px-2.5 py-1 rounded-full bg-amber-50 text-amber-800 ring-1 ring-amber-200 text-xs';
                span.textContent = t;
                prev.appendChild(span);
            });
            if (chips.length === 0) {
                prev.innerHTML = '<span class="text-sm text-gray-500">Nothing selected yet. Choose components in Step 2.</span>';
            }
        }

        document.addEventListener('click', (e) => {
            const b = e.target.closest('.step-btn');
            if (!b) return;
            const inp = document.getElementById(b.dataset.for);
            if (!inp || inp.disabled) return;
            const cur = parseInt(inp.value || '0', 10);
            inp.value = Math.max(0, cur + parseInt(b.dataset.dir, 10));
            recalcUnitPrice();
        });

        document.addEventListener('input', (e) => {
            if (e.target.classList.contains('qty-input') || e.target.name === 'LaborPerPiece') recalcUnitPrice();
        });

        document.addEventListener('DOMContentLoaded', recalcUnitPrice);

        document.querySelector('form[action*="AddCustomRecipe"]').addEventListener('submit', function (e) {
            const any = Array.from(document.querySelectorAll('.qty-input'))
                .some(inp => !inp.disabled && parseInt(inp.value || '0', 10) > 0);
            if (!any) {
                e.preventDefault();
                alert('Please choose at least one in-stock component for your design.');
            }
        });
    </script>
}
