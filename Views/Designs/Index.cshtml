@model IEnumerable<OneJevelsCompany.Web.Models.Design>

@{
    ViewData["Title"] = "Our Designs";
}

<!-- HERO SECTION -->
<section class="relative h-[420px] md:h-[520px] mb-16 overflow-hidden rounded-[2rem] max-w-7xl mx-auto mt-10">

    <!-- IMAGE -->
    <img src="/images/angel-wings.jpg"
         alt="Design inspiration"
         class="absolute inset-0 w-full h-full object-cover" />

    <!-- OVERLAY -->
    <div class="absolute inset-0 bg-black/50"></div>

    <!-- TEXT -->
    <div class="relative z-10 h-full flex flex-col justify-center items-center text-center px-6">

        <div class="text-sm uppercase tracking-[0.4em] text-white/70 mb-4">
            Design Inspiration
        </div>

        <h1 class="text-3xl md:text-5xl font-semibold text-white mb-6">
            Where jewellery becomes art
        </h1>

        <a href="/Build"
           class="bg-white text-amber-700 px-6 py-3 rounded-lg hover:bg-amber-100 transition shadow">
            Create Your Design
        </a>

    </div>

</section>

<!-- TITLE -->
<h2 class="text-2xl font-semibold text-amber-700 mb-10 text-center">
    Our Best Designs
</h2>

<!-- DESIGNS GRID -->
<div class="max-w-7xl mx-auto px-6 pb-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

        @foreach (var d in Model)
        {
            <div class="bg-white/80 backdrop-blur-sm shadow-md rounded-2xl p-6 border border-amber-100 transition duration-300 hover:shadow-xl hover:-translate-y-1">

                <h3 class="text-lg font-semibold text-gray-800 mb-2">
                    @d.Name
                </h3>

                <p class="text-sm text-gray-500 mb-3">
                    Category: @d.Category
                </p>

                <p class="text-gray-600 text-sm leading-6">
                    @d.Description
                </p>

            </div>
        }

    </div>
</div>