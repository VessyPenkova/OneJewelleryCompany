@{
    ViewData["Title"] = "Home";
}

<section class="max-w-7xl mx-auto px-6 py-20 md:py-28 grid md:grid-cols-2 gap-20 items-center">

    <!-- LEFT SIDE -->
    <div class="text-left max-w-lg">

        <div class="text-sm uppercase tracking-[0.25em] text-amber-700/80 mb-4">
            Timeless Elegance
        </div>

        <h1 class="text-4xl md:text-5xl font-semibold text-amber-700 leading-tight mb-6">
            Crafted for your most
            <span class="block">beautiful moments</span>
        </h1>

        <p class="text-gray-600 text-lg leading-8 mb-8">
            Discover refined jewellery designed to celebrate your style, your story,
            and the moments that matter most.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">

            <a href="/Collections"
               class="bg-amber-600 text-white px-6 py-3 rounded-lg hover:bg-amber-500 transition shadow-sm">
                Explore Collections
            </a>

            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <a href="/Build"
                   class="bg-white text-amber-700 border border-amber-300 px-6 py-3 rounded-lg hover:bg-amber-50 transition">
                    Build your own
                </a>
            }
            else
            {
                <a href="/Account/Login?returnUrl=/Build"
                   class="bg-white text-amber-700 border border-amber-300 px-6 py-3 rounded-lg hover:bg-amber-50 transition">
                    Build your own
                </a>
            }

        </div>

        @if (!(User?.Identity?.IsAuthenticated ?? false))
        {
            <p class="text-sm text-gray-500 mt-4">
                Login / Register required for custom design
            </p>
        }

    </div>

    <!-- RIGHT SIDE -->
    <div class="flex justify-center md:justify-end md:pt-8">
        <div class="w-full max-w-md lg:max-w-lg">
            <img src="/images/hero-jewelry.jpg"
                 alt="Luxury jewellery"
                 class="w-full rounded-[2rem] shadow-xl object-cover transition duration-300 hover:scale-[1.02]" />
        </div>
    </div>

</section>

<!-- FEATURED COLLECTIONS -->
<section class="max-w-7xl mx-auto px-6 py-20">

    <h2 class="text-3xl font-light tracking-wide text-amber-700 mb-12 text-center">
        Featured Collections
    </h2>

    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-10">

        <!-- Rings -->
        <a href="/Collections"
           class="group block bg-white/70 backdrop-blur-sm rounded-2xl p-4 shadow-sm border border-amber-100 hover:shadow-md transition">

            <div class="overflow-hidden rounded-xl">
                <img src="/images/collection-rings.jpg"
                     alt="Rings"
                     class="w-full h-48 object-cover transition duration-300 group-hover:scale-105" />
            </div>

            <h3 class="mt-4 text-lg font-medium text-gray-800 text-center">
                Rings
            </h3>
        </a>

        <!-- Necklaces -->
        <a href="/Collections?category=Necklace"
           class="group block bg-white/70 backdrop-blur-sm rounded-2xl p-4 shadow-sm border border-amber-100 hover:shadow-md transition">

            <div class="overflow-hidden rounded-xl">
                <img src="/images/collection-necklaces.jpg"
                     alt="Necklaces"
                     class="w-full h-48 object-cover transition duration-300 group-hover:scale-105" />
            </div>

            <h3 class="mt-4 text-lg font-medium text-gray-800 text-center">
                Necklaces
            </h3>
        </a>

        <!-- Bracelets -->
        <a href="/Collections?category=Bracelet"
           class="group block bg-white/70 backdrop-blur-sm rounded-2xl p-4 shadow-sm border border-amber-100 hover:shadow-md transition">

            <div class="overflow-hidden rounded-xl">
                <img src="/images/collection-bracelets.jpg"
                     alt="Bracelets"
                     class="w-full h-48 object-cover transition duration-300 group-hover:scale-105" />
            </div>

            <h3 class="mt-4 text-lg font-medium text-gray-800 text-center">
                Bracelets
            </h3>
        </a>

    </div>

</section>