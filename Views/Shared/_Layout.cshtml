@{
    var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLowerInvariant();
    var area = (ViewContext.RouteData.Values["area"]?.ToString() ?? "").ToLowerInvariant();
    var isAdmin = User.IsInRole("Admin");

    bool useAdminShell = isAdmin && (controller == "admin" || controller == "inventory" || area == "admin");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - One Jewellery Company</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&display=swap" rel="stylesheet">
    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Theme -->
    <link rel="stylesheet" href="~/css/champagne-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- ✅ FAVICON -->
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
</head>

<body class="font-sans text-gray-800 min-h-screen flex flex-col">

    <!-- NAVBAR -->
    <nav class="bg-white/95 backdrop-blur border-b border-amber-100 shadow-sm">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex items-center justify-between h-20">

                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index" class="leading-tight">
                    <div class="text-2xl font-bold text-amber-700">
                        One Jewellery Company
                    </div>
                    <div class="text-xs text-gray-500">
                        Crafted elegance for every detail
                    </div>
                </a>

                <!-- Menu -->
                <div class="flex items-center gap-6 text-sm font-medium">

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="nav-link">Admin</a>
                        <a asp-controller="Admin" asp-action="Invoices" class="nav-link">Invoices</a>
                        <a asp-controller="Admin" asp-action="Components" class="nav-link">Components</a>
                        <a asp-controller="Admin" asp-action="Jewels" class="nav-link">Jewels</a>
                        <a href="/Inventory" class="nav-link">Inventory</a>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                        <a asp-controller="Home" asp-action="About" class="nav-link">About</a>
                        <a asp-controller="Shop" asp-action="Collections" class="nav-link">Collections</a>
                        <a asp-controller="Shop" asp-action="Build" class="nav-link">Build Your Own</a>
                        <a asp-controller="Designs" asp-action="Index" class="nav-link">Designs</a>
                        <a asp-controller="Cart" asp-action="Cart" class="nav-link">Cart</a>
                    }

                    <!-- Auth -->
                    <div class="flex items-center gap-3 ml-4">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <span class="text-gray-600 text-sm">
                                @User.Identity.Name
                            </span>

                            <form method="post" asp-controller="Account" asp-action="Logout">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-nav">
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn-nav">
                                Login
                            </a>

                            <a asp-controller="Account" asp-action="Register" class="btn-nav">
                                Register
                            </a>
                        }
                    </div>
                </div>

            </div>
        </div>
    </nav>

    <!-- ADMIN LAYOUT -->
    @if (useAdminShell)
    {
        <div class="flex flex-1">
            <aside class="w-64 bg-white border-r p-4">
                <a href="/Admin/Dashboard" class="block py-2">Dashboard</a>
                <a href="/Admin/Invoices" class="block py-2">Invoices</a>
                <a href="/Admin/Components" class="block py-2">Components</a>
                <a href="/Admin/Jewels" class="block py-2">Jewels</a>
                <a href="/Admin/Inventory" class="block py-2">Inventory</a>
            </aside>

            <main class="flex-1 p-6">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="flex-1 container mx-auto px-4 mt-8">
            @RenderBody()
        </main>
    }

    <!-- FOOTER -->
    <footer class="text-center text-sm text-gray-500 border-t py-4 mt-10">
        &copy; @DateTime.Now.Year One Jewellery Company — Crafted with 💎 precision
    </footer>

    @RenderSection("Scripts", required: false)

</body>
</html>