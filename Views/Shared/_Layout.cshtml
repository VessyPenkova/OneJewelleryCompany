@* Views/Shared/_Layout.cshtml *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - One Jewellery Company</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/champagne-theme.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="announcement-bar">Designed with intention · Crafted with precision</div>
        <nav class="site-nav">
            <div class="nav-inner">
                <a asp-controller="Home" asp-action="Index" class="brand" aria-label="One Jewellery Company home">
                    <span class="brand-mark">◇</span>
                    <span>ONE <strong>JEWELLERY</strong> COMPANY</span>
                </a>

                <div class="nav-links">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index">Dashboard</a>
                        <a asp-controller="Admin" asp-action="Invoices">Invoices</a>
                        <a asp-controller="Admin" asp-action="Components">Components</a>
                        <a asp-controller="Admin" asp-action="Jewels">Jewels</a>
                        <a asp-controller="Admin" asp-action="DesignOrders">Design Orders</a>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <a asp-controller="Shop" asp-action="Collections">Collections</a>
                        <a asp-controller="Shop" asp-action="Build">Build Your Own</a>
                        <a asp-controller="Designs" asp-action="Index">Designs</a>
                        <a asp-controller="Home" asp-action="About">Our Story</a>
                        <a asp-controller="Cart" asp-action="Cart" class="nav-cart">Bag</a>
                    }
                </div>

                <div class="auth-links">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <span class="user-name">@User.Identity!.Name</span>
                        <form method="post" asp-area="Identity" asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Action("Index", "Home")">
                            <button type="submit" class="link-button">Sign out</button>
                        </form>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login">Sign in</a>
                        <a asp-area="Identity" asp-page="/Account/Register" class="nav-cta">Create account</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div>
                <div class="footer-brand">ONE JEWELLERY COMPANY</div>
                <p>Individual pieces. Thoughtful design. Timeless character.</p>
            </div>
            <div class="footer-meta">© @DateTime.Now.Year One Jewellery Company · Crafted with precision</div>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
