@model IEnumerable<OneJevelsCompany.Core.Entities.Component>
@using OneJevelsCompany.Core.Enums

@{
    ViewData["Title"] = "Components";
    var category = JewelCategory.Necklace;
    var pieceName = category.ToString();
    var pieceNameLower = pieceName.ToLowerInvariant();
}

<div class="max-w-6xl mx-auto space-y-6">

    <section class="rounded-2xl border border-amber-200 bg-white overflow-hidden shadow-sm">
        <div class="px-6 py-7 md:px-9 md:py-9">
            <div class="text-xs uppercase tracking-[0.24em] text-amber-700 font-semibold">
                Jewellery Components
            </div>

            <h1 class="mt-2 text-3xl md:text-4xl font-semibold text-gray-900">
                Components
            </h1>

            <p class="mt-3 max-w-2xl text-gray-600 leading-7">
                Browse the available jewellery components and select the quantities you would like to purchase.
            </p>
        </div>
    </section>

    <form asp-controller="Cart" asp-action="AddComponents" method="post" class="space-y-6">
        @Html.AntiForgeryToken()

        <input type="hidden" name="Category" value="@((int)category)" />

        <section class="bg-white rounded-2xl border shadow-sm p-6 md:p-7">
            <div class="mb-6">
                <div class="text-xs uppercase tracking-wider text-amber-700 font-semibold">
                    Components
                </div>

                <h2 class="text-xl font-semibold text-gray-900 mt-1">
                    Choose Components
                </h2>

                <p class="text-sm text-gray-600 mt-1">
                    Use + and − to choose the quantity of each component you would like to purchase.
                </p>
            </div>

            @foreach (var group in Model
                        .GroupBy(c => new
                        {
                            Name = c.Category?.Name ?? "Other",
                            Order = c.Category?.SortOrder ?? 999
                        })
                        .OrderBy(g => g.Key.Order))
            {
                <div class="mb-7 last:mb-0">
                    <div class="flex items-center gap-3 mb-3">
                        <h3 class="text-base font-semibold text-gray-900">
                            @group.Key.Name
                        </h3>

                        <div class="h-px flex-1 bg-gray-200"></div>
                    </div>

                    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">

                        @foreach (var c in group.OrderBy(x => x.Name))
                        {
                            var outOfStock = c.QuantityOnHand <= 0;

                            <article class="component-card relative rounded-xl border bg-white p-4 transition hover:shadow-md @(outOfStock ? "opacity-60" : "")">

                                <div class="flex gap-3">

                                    <div class="h-16 w-16 shrink-0 rounded-lg border bg-gray-50 overflow-hidden grid place-items-center">

                                        @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                                        {
                                            <img src="@c.ImageUrl"
                                                 alt="@c.Name"
                                                 class="h-full w-full object-contain" />
                                        }
                                        else
                                        {
                                            <span class="text-2xl text-amber-700"
                                                  aria-hidden="true">
                                                ◇
                                            </span>
                                        }

                                    </div>

                                    <div class="min-w-0 flex-1">

                                        <div class="component-name font-semibold text-gray-900 leading-5"
                                             title="@c.Name">
                                            @c.Name
                                        </div>

                                        <div class="mt-1 text-xs leading-5 text-gray-500">

                                            @if (!string.IsNullOrEmpty(c.Color))
                                            {
                                                <span>@c.Color · </span>
                                            }

                                            @if (!string.IsNullOrEmpty(c.SizeLabel))
                                            {
                                                <span>@c.SizeLabel · </span>
                                            }

                                            @if (!string.IsNullOrEmpty(c.Dimensions))
                                            {
                                                <span>@c.Dimensions · </span>
                                            }

                                        <span>@c.Price.ToString("C")</span>

                                    </div>

                                    <div class="text-xs @(outOfStock ? "text-red-600" : "text-gray-500")">
                                        @(outOfStock
                                                                            ? "Out of stock"
                                                                            : $"{c.QuantityOnHand} available")
                                </div>

                                    </div>
                                </div>

                                <div class="mt-4 flex items-end justify-between gap-3">

                                    <div>

                                        <label for="qty-@c.Id"
                                               class="block text-xs font-medium text-gray-600 mb-1">
                                            Quantity
                                        </label>

                                        <div class="flex items-center gap-2">

                                            <button type="button"
                                                    class="h-9 w-9 rounded-lg border text-gray-700 hover:bg-gray-50"
                                                    onclick="changeQuantity('qty-@c.Id', -1)"
                                                    aria-label="Decrease @c.Name">
                                                −
                                            </button>

                                            <input id="qty-@c.Id"
                                                   type="number"
                                                   min="0"
                                                   value="0"
                                                   name="Components[@c.Id].Quantity"
                                                   data-price="@c.Price"
                                                   class="qty-input h-9 w-16 rounded-lg border text-center"
                                                   @(outOfStock ? "disabled" : "") />

                                            <button type="button"
                                                    class="h-9 w-9 rounded-lg border text-gray-700 hover:bg-gray-50"
                                                    onclick="changeQuantity('qty-@c.Id', 1)"
                                                    aria-label="Increase @c.Name">
                                                +
                                            </button>

                                        </div>
                                    </div>

                                    <a asp-controller="Shop"
                                       asp-action="Details"
                                       asp-route-id="@c.Id"
                                       class="text-sm text-amber-800 hover:underline">
                                        Details
                                    </a>

                                </div>

                            </article>
                                        }

                    </div>
                </div>
            }

        </section>

        <section class="grid lg:grid-cols-[1fr_360px] gap-6 items-start">

            <div class="bg-white rounded-2xl border shadow-sm p-6 md:p-7">

                <div class="text-xs uppercase tracking-wider text-amber-700 font-semibold">
                    Your Order
                </div>

                <h2 class="text-xl font-semibold text-gray-900 mt-1">
                    Review your order
                </h2>

                <p class="text-sm text-gray-600 mt-1 mb-5">
                    Check the selected components and quantities before continuing to your cart.
                </p>

                <div class="mt-5">

                    <div class="text-sm font-semibold text-gray-700 mb-2">
                        Selected components
                    </div>

                    <div id="preview"
                         class="flex flex-wrap gap-2">
                    </div>

                </div>

            </div>

            <aside class="bg-gray-900 text-white rounded-2xl shadow-sm p-6 lg:sticky lg:top-24">

                <div class="text-xs uppercase tracking-wider text-amber-200 font-semibold">
                    Order Summary
                </div>

                <div class="mt-5 border-t border-white/15 pt-5 flex items-end justify-between gap-4">

                    <div>
                        <div class="text-sm text-gray-300">
                            Order total
                        </div>
                    </div>

                    <input id="unitPrice"
                           type="text"
                           readonly
                           class="w-32 bg-transparent text-right text-2xl font-semibold text-amber-200 outline-none"
                           value="$0.00" />

                </div>

                <button type="submit"
                        class="mt-6 w-full rounded-xl bg-amber-600 px-6 py-3.5 font-semibold text-white hover:bg-amber-500 transition">
                    Proceed to Cart
                </button>

                <a asp-controller="Shop"
                   asp-action="Collections"
                   class="mt-3 block text-center text-sm text-gray-300 hover:text-white">
                    Continue Shopping
                </a>

            </aside>

        </section>

    </form>

</div>

@section Scripts {

    <script>

        function changeQuantity(inputId, change) {

            const inp = document.getElementById(inputId);

            if (!inp || inp.disabled)
                return;

            const current = parseInt(inp.value || '0', 10);

            inp.value = Math.max(0, current + change);

            recalcUnitPrice();
        }

        function recalcUnitPrice() {

            let total = 0;
            const chips = [];

            document.querySelectorAll('.qty-input').forEach(inp => {

                if (inp.disabled)
                    return;

                const quantity = parseInt(inp.value || '0', 10);
                const price = parseFloat(inp.dataset.price || '0');

                if (!isNaN(quantity) &&
                    !isNaN(price) &&
                    quantity > 0) {

                    total += quantity * price;

                    const card = inp.closest('.component-card');

                    const name = card
                        ? card.querySelector('.component-name').textContent.trim()
                        : 'Component';

                    chips.push(`${quantity}× ${name}`);
                }
            });

            document.getElementById('unitPrice').value =
                total.toLocaleString(
                    undefined,
                    {
                        style: 'currency',
                        currency: 'USD'
                    });

            const preview = document.getElementById('preview');

            preview.innerHTML = '';

            chips.forEach(text => {

                const span = document.createElement('span');

                span.className =
                    'inline-flex items-center px-2.5 py-1 rounded-full bg-amber-50 text-amber-800 ring-1 ring-amber-200 text-xs';

                span.textContent = text;

                preview.appendChild(span);
            });

            if (chips.length === 0) {

                preview.innerHTML =
                    '<span class="text-sm text-gray-500">Nothing selected yet. Choose components above.</span>';
            }
        }

        document.addEventListener('input', (e) => {

            if (e.target.classList.contains('qty-input'))
                recalcUnitPrice();
        });

        document.addEventListener(
            'DOMContentLoaded',
            recalcUnitPrice);

       
        document
        .querySelector('form[action*="AddComponents"]')
            .addEventListener('submit', function (e) {

                const any = Array
                    .from(document.querySelectorAll('.qty-input'))
                    .some(inp =>
                        !inp.disabled &&
                        parseInt(inp.value || '0', 10) > 0);

                if (!any) {

                    e.preventDefault();

                    alert(
                        'Please choose at least one in-stock component.'
                    );
                }
            });

    </script>
}