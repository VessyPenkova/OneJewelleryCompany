@{
    ViewData["Title"] = "About Us";
}

<section class="relative overflow-hidden bg-gradient-to-b from-[#f8f3eb] via-[#f5efe6] to-[#efe6d8]">
    <div class="absolute inset-0 opacity-20 pointer-events-none">
        <div class="absolute -top-20 -left-20 w-72 h-72 rounded-full bg-amber-200 blur-3xl"></div>
        <div class="absolute top-32 right-0 w-80 h-80 rounded-full bg-yellow-100 blur-3xl"></div>
        <div class="absolute bottom-0 left-1/3 w-96 h-96 rounded-full bg-stone-200 blur-3xl"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-6 py-20 md:py-28">
        <div class="grid lg:grid-cols-2 gap-14 items-center">

            <!-- LEFT -->
            <div>
                <div class="text-sm uppercase tracking-[0.35em] text-amber-700/80 mb-5">
                    Refined Elegance
                </div>

                <h1 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-[#9f7a43] leading-tight mb-6">
                    About One Jewellery Company
                </h1>

                <p class="text-lg text-stone-700 leading-8 mb-6">
                    At One Jewellery Company, we believe jewellery is more than an accessory.
                    It is a personal statement, a memory, and a quiet expression of elegance.
                </p>

                <p class="text-stone-600 leading-8 mb-8">
                    Founded with a passion for timeless beauty, our brand blends artistry,
                    precision, and delicate craftsmanship to create pieces that feel both
                    graceful and meaningful.
                </p>

                <!-- VALUES -->
                <div class="grid sm:grid-cols-3 gap-4">
                    <div class="rounded-2xl bg-white/70 backdrop-blur-sm border border-amber-100 p-5 shadow-sm text-center transition duration-300 hover:shadow-xl hover:-translate-y-1">
                        <div class="text-2xl font-semibold text-[#9f7a43]">Timeless</div>
                        <div class="text-sm text-stone-600 mt-2">Classic beauty</div>
                    </div>

                    <div class="rounded-2xl bg-white/70 backdrop-blur-sm border border-amber-100 p-5 shadow-sm text-center transition duration-300 hover:shadow-xl hover:-translate-y-1">
                        <div class="text-2xl font-semibold text-[#9f7a43]">Precise</div>
                        <div class="text-sm text-stone-600 mt-2">Crafted with care</div>
                    </div>

                    <div class="rounded-2xl bg-white/70 backdrop-blur-sm border border-amber-100 p-5 shadow-sm text-center transition duration-300 hover:shadow-xl hover:-translate-y-1">
                        <div class="text-2xl font-semibold text-[#9f7a43]">Elegant</div>
                        <div class="text-sm text-stone-600 mt-2">Refined style</div>
                    </div>
                </div>
            </div>

            <!-- RIGHT IMAGE -->
            <div class="relative">
                <div class="rounded-[2rem] overflow-hidden shadow-2xl border border-white/60 bg-white/40 backdrop-blur-sm">
                    <img src="/images/hero-jewelry.jpg"
                         alt="Luxury jewellery"
                         class="w-full h-[520px] object-cover" />
                </div>

                <!-- FIXED PHILOSOPHY CARD (NOW CORRECT POSITION) -->
                <div class="absolute bottom-6 right-6 max-w-[260px] rounded-2xl bg-white/90 backdrop-blur-md border border-amber-100 shadow-xl p-5">
                    <div class="text-xs uppercase tracking-[0.25em] text-amber-700/70 mb-2">
                        Our Philosophy
                    </div>
                    <p class="text-sm text-stone-700 leading-6">
                        Every piece should feel elegant, personal, and unforgettable —
                        because jewellery should reflect the soul.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- SECOND SECTION -->
<section class="bg-gradient-to-b from-[#fbf8f3] to-[#f3ebe0]">
    <div class="max-w-6xl mx-auto px-6 py-20">

        <div class="text-center max-w-3xl mx-auto mb-14">
            <div class="text-sm uppercase tracking-[0.3em] text-amber-700/70 mb-4">
                What Makes Us Special
            </div>

            <h2 class="text-3xl md:text-4xl font-semibold text-[#9f7a43] mb-5">
                Crafted for beauty, designed for meaning
            </h2>

            <p class="text-stone-600 leading-8">
                We create jewellery that brings together visual elegance and emotional value.
            </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">

            <div class="rounded-3xl bg-white border border-amber-100 shadow-sm p-8 transition duration-300 hover:shadow-xl hover:-translate-y-1">
                <div class="w-12 h-12 rounded-full bg-amber-50 border border-amber-200 flex items-center justify-center mb-5 text-amber-700 text-xl">
                    ✦
                </div>
                <h3 class="text-xl font-semibold text-stone-800 mb-3">Luxury Aesthetic</h3>
                <p class="text-stone-600 leading-7">
                    Soft tones and refined forms define our collections.
                </p>
            </div>

            <div class="rounded-3xl bg-white border border-amber-100 shadow-sm p-8 transition duration-300 hover:shadow-xl hover:-translate-y-1">
                <div class="w-12 h-12 rounded-full bg-amber-50 border border-amber-200 flex items-center justify-center mb-5 text-amber-700 text-xl">
                    ✦
                </div>
                <h3 class="text-xl font-semibold text-stone-800 mb-3">Craftsmanship</h3>
                <p class="text-stone-600 leading-7">
                    Precision and balance in every detail.
                </p>
            </div>

            <div class="rounded-3xl bg-white border border-amber-100 shadow-sm p-8 transition duration-300 hover:shadow-xl hover:-translate-y-1">
                <div class="w-12 h-12 rounded-full bg-amber-50 border border-amber-200 flex items-center justify-center mb-5 text-amber-700 text-xl">
                    ✦
                </div>
                <h3 class="text-xl font-semibold text-stone-800 mb-3">Meaning</h3>
                <p class="text-stone-600 leading-7">
                    Jewellery that tells a personal story.
                </p>
            </div>

        </div>

    </div>
</section>