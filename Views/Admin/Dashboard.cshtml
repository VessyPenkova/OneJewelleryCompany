@model OneJevelsCompany.Web.Models.Admin.DashboardVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="space-y-6">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3">
        <div>
            <h1 class="text-3xl font-bold text-gray-800">Dashboard</h1>
            <p class="text-sm text-gray-500 mt-1">Overview of sales and order status.</p>
        </div>
        <div class="text-sm text-gray-400">
            @DateTime.Now.ToString("dddd, dd MMM yyyy")
        </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">
            <div class="flex items-center justify-between">
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wide">Total Sales</div>
                <span class="h-3 w-3 rounded-full bg-amber-400"></span>
            </div>
            <div class="mt-4 text-3xl font-bold text-gray-800">@Model.TotalSales.ToString("C")</div>
        </div>

        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">
            <div class="flex items-center justify-between">
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wide">Today</div>
                <span class="h-3 w-3 rounded-full bg-green-400"></span>
            </div>
            <div class="mt-4 text-3xl font-bold text-gray-800">@Model.TodaysSales.ToString("C")</div>
        </div>

        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">
            <div class="flex items-center justify-between">
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wide">Not Initiated</div>
                <span class="h-3 w-3 rounded-full bg-rose-300"></span>
            </div>
            <div class="mt-4 text-3xl font-bold text-gray-800">@Model.NotInitiatedValue.ToString("C")</div>
        </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">
            <div class="flex items-center justify-between">
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wide">Item Orders</div>
                <span class="h-3 w-3 rounded-full bg-sky-400"></span>
            </div>
            <div class="mt-4 text-3xl font-bold text-gray-800">@Model.ItemOrdersCount</div>
            <div class="mt-3">
                <a href="/Admin/ItemOrders" class="text-sm font-medium text-[#7a623f] hover:text-[#b08d57] transition">
                    Open Item Orders
                </a>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">
            <div class="flex items-center justify-between">
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wide">Jewelry Orders</div>
                <span class="h-3 w-3 rounded-full bg-violet-400"></span>
            </div>
            <div class="mt-4 text-3xl font-bold text-gray-800">@Model.JewelryOrdersCount</div>
            <div class="mt-3">
                <a href="/Admin/JewelryOrders" class="text-sm font-medium text-[#7a623f] hover:text-[#b08d57] transition">
                    Open Jewelry Orders
                </a>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">
            <div class="flex items-center justify-between">
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wide">Design Orders</div>
                <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
            </div>
            <div class="mt-4 text-3xl font-bold text-gray-800">@Model.DesignOrdersCount</div>
            <div class="mt-3 flex gap-4">
                <a href="/Admin/DesignOrders" class="text-sm font-medium text-[#7a623f] hover:text-[#b08d57] transition">
                    Pending
                </a>
                <a href="/Admin/ReadyDesignOrders" class="text-sm font-medium text-[#7a623f] hover:text-[#b08d57] transition">
                    Ready
                </a>
            </div>
        </div>
    </div>
</div>