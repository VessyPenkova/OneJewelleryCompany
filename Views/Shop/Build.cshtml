@model IEnumerable<OneJevelsCompany.Core.Entities.Component>
@using OneJevelsCompany.Core.Enums

@{
    ViewData["Title"] = "Build Your Own Jewellery";
    var category = (JewelCategory)ViewBag.Category;
    var pieceName = category.ToString();
}

<div class="max-w-6xl mx-auto space-y-7">

    <!-- ======================================================= -->
    <!-- HERO                                                    -->
    <!-- ======================================================= -->
    <section class="grid lg:grid-cols-[0.95fr_1.25fr] gap-8 items-center">

        <div class="py-4">

            <div class="text-xs uppercase tracking-[0.24em] text-amber-700 font-semibold">
                Your jewellery, your design
            </div>

            <h1 class="mt-3 text-4xl md:text-5xl font-semibold text-gray-900 leading-tight">
                Build Your Own Jewellery
            </h1>

            <p class="mt-5 max-w-xl text-gray-600 leading-7">
                Choose the type of jewellery you would like to create,
                then continue to the 3D Design Studio to arrange your components
                and create your own design.
            </p>

            <div class="mt-7 flex flex-wrap items-center gap-5 text-sm">

                <div class="flex items-center gap-2">
                    <span class="grid h-8 w-8 place-items-center rounded-full bg-amber-700 text-white text-xs font-semibold">
                        1
                    </span>

                    <span class="font-medium text-gray-900">
                        Choose type
                    </span>
                </div>

                <div class="hidden sm:block h-px w-16 bg-amber-300"></div>

                <div class="flex items-center gap-2">
                    <span class="grid h-8 w-8 place-items-center rounded-full border border-amber-500 text-amber-800 text-xs font-semibold">
                        2
                    </span>

                    <span class="font-medium text-gray-900">
                        Design in 3D
                    </span>
                </div>

            </div>

        </div>


        <div class="overflow-hidden rounded-2xl border border-amber-200 bg-white shadow-sm">

            <img src="~/Images/BuildDesignStudio.jpg"
                 alt="Jewellery 3D Design Studio preview"
                 class="w-full h-[310px] md:h-[350px] object-cover" />

        </div>

    </section>


    <!-- ======================================================= -->
    <!-- JEWELLERY TYPE                                          -->
    <!-- ======================================================= -->
    <section class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">

        <div class="p-6 md:p-8">

            <div class="text-xs uppercase tracking-[0.18em] text-amber-700 font-semibold">
                Step 1
            </div>

            <h2 class="mt-2 text-2xl font-semibold text-gray-900">
                What would you like to create?
            </h2>

            <p class="mt-2 text-sm text-gray-600">
                Choose Necklace or Bracelet, then open the 3D Design Studio.
            </p>


            <div class="mt-6 grid md:grid-cols-2 gap-5">

                <!-- NECKLACE -->
                <a href="/Shop/Build?category=Necklace"
                   class="rounded-2xl border-2 px-6 py-5 transition
                          @(category == JewelCategory.Necklace
                                                 ? "border-amber-600 bg-amber-50"
                                                 : "border-gray-200 bg-white hover:border-amber-300")">

                    <div class="flex items-center gap-5">

                        <!-- Necklace line illustration -->
                        <div class="w-28 h-20 shrink-0 flex items-center justify-center">

                            <svg viewBox="0 0 120 80"
                                 class="w-24 h-16 text-amber-600"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.6"
                                 stroke-linecap="round">

                                <path d="M18 12
                                         C25 43 40 58 60 61
                                         C80 58 95 43 102 12" />

                                <circle cx="60"
                                        cy="61"
                                        r="7"
                                        fill="#f7f2e7"
                                        stroke="currentColor" />

                                <circle cx="60"
                                        cy="61"
                                        r="3"
                                        fill="currentColor"
                                        stroke="none" />

                            </svg>

                        </div>


                        <div class="min-w-0 flex-1">

                            <div class="text-xl font-semibold text-gray-900">
                                Necklace
                            </div>

                            <div class="mt-1 text-sm leading-6 text-gray-500">
                                Create your own necklace<br />
                                in the 3D Design Studio.
                            </div>

                        </div>


                        @if (category == JewelCategory.Necklace)
                        {
                            <span class="shrink-0 rounded-full bg-amber-100 px-4 py-2 text-sm font-semibold text-amber-800">
                                Selected
                            </span>
                        }
                        else
                        {
                            <span class="shrink-0 h-9 w-9 rounded-full border-2 border-amber-300"></span>
                        }

                    </div>

                </a>


                <!-- BRACELET -->
                <a href="/Shop/Build?category=Bracelet"
                   class="rounded-2xl border-2 px-6 py-5 transition
                          @(category == JewelCategory.Bracelet
                                                 ? "border-amber-600 bg-amber-50"
                                                 : "border-gray-200 bg-white hover:border-amber-300")">

                    <div class="flex items-center gap-5">

                        <!-- Bracelet line illustration -->
                        <div class="w-28 h-20 shrink-0 flex items-center justify-center">

                            <svg viewBox="0 0 120 80"
                                 class="w-24 h-16 text-amber-600"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.6">

                                <ellipse cx="60"
                                         cy="39"
                                         rx="40"
                                         ry="24" />

                                <circle cx="60"
                                        cy="62"
                                        r="6.5"
                                        fill="#f7f2e7"
                                        stroke="currentColor" />

                                <circle cx="60"
                                        cy="62"
                                        r="2.8"
                                        fill="currentColor"
                                        stroke="none" />

                            </svg>

                        </div>


                        <div class="min-w-0 flex-1">

                            <div class="text-xl font-semibold text-gray-900">
                                Bracelet
                            </div>

                            <div class="mt-1 text-sm leading-6 text-gray-500">
                                Create your own bracelet<br />
                                in the 3D Design Studio.
                            </div>

                        </div>


                        @if (category == JewelCategory.Bracelet)
                        {
                            <span class="shrink-0 rounded-full bg-amber-100 px-4 py-2 text-sm font-semibold text-amber-800">
                                Selected
                            </span>
                        }
                        else
                        {
                            <span class="shrink-0 h-9 w-9 rounded-full border-2 border-amber-300"></span>
                        }

                    </div>

                </a>

            </div>

        </div>


        <!-- =================================================== -->
        <!-- CONTINUE                                            -->
        <!-- =================================================== -->
        <div class="border-t bg-amber-50/40 px-6 py-5 md:px-8">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5">

                <div>

                    <div class="text-lg font-semibold text-gray-900">
                        Ready to create your @pieceName?
                    </div>

                    <div class="mt-1 text-sm text-gray-600">
                        Arrange your components and preview your jewellery in the 3D Design Studio.
                    </div>

                </div>


                <a asp-controller="Shop"
                   asp-action="Design"
                   asp-route-category="@category"
                   class="inline-flex shrink-0 items-center justify-center gap-3 rounded-xl bg-gray-900 px-6 py-3.5 text-white font-semibold hover:bg-gray-800 transition">

                    <span class="rotate-45 inline-block h-3 w-3 border border-white/80"></span>

                    Continue to 3D Design Studio

                </a>

            </div>

        </div>

    </section>


    <!-- ======================================================= -->
    <!-- DESIGN STUDIO FEATURES                                  -->
    <!-- ======================================================= -->
    <section class="grid sm:grid-cols-2 lg:grid-cols-4">


        <!-- 3D PREVIEW -->
        <div class="flex gap-4 px-5 py-5 lg:border-r border-amber-200">

            <div class="shrink-0 text-amber-600">

                <svg viewBox="0 0 32 32"
                     class="w-8 h-8"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linejoin="round">

                    <path d="M16 3 27 9 16 15 5 9 16 3Z" />
                    <path d="M5 9v13l11 7V15" />
                    <path d="M27 9v13l-11 7" />

                </svg>

            </div>

            <div>

                <div class="font-semibold text-gray-900">
                    3D preview
                </div>

                <div class="mt-1 text-sm leading-5 text-gray-500">
                    See your design in real time.
                </div>

            </div>

        </div>


        <!-- COMPONENTS -->
        <div class="flex gap-4 px-5 py-5 lg:border-r border-amber-200">

            <div class="shrink-0 text-amber-600">

                <svg viewBox="0 0 32 32"
                     class="w-8 h-8"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <circle cx="16" cy="7" r="4" />
                    <circle cx="9" cy="20" r="5" />
                    <circle cx="23" cy="20" r="5" />

                </svg>

            </div>

            <div>

                <div class="font-semibold text-gray-900">
                    Choose your own components
                </div>

                <div class="mt-1 text-sm leading-5 text-gray-500">
                    Beads, charms, spacers and more.
                </div>

            </div>

        </div>


        <!-- ADJUST -->
        <div class="flex gap-4 px-5 py-5 lg:border-r border-amber-200">

            <div class="shrink-0 text-amber-600">

                <svg viewBox="0 0 32 32"
                     class="w-8 h-8"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round">

                    <path d="M4 8h24" />
                    <path d="M4 16h24" />
                    <path d="M4 24h24" />

                    <circle cx="12" cy="8" r="3" fill="#faf7f0" />
                    <circle cx="21" cy="16" r="3" fill="#faf7f0" />
                    <circle cx="15" cy="24" r="3" fill="#faf7f0" />

                </svg>

            </div>

            <div>

                <div class="font-semibold text-gray-900">
                    Adjust size &amp; arrangement
                </div>

                <div class="mt-1 text-sm leading-5 text-gray-500">
                    Create it just the way you like.
                </div>

            </div>

        </div>


        <!-- FINAL PREVIEW -->
        <div class="flex gap-4 px-5 py-5">

            <div class="shrink-0 text-amber-600">

                <svg viewBox="0 0 32 32"
                     class="w-8 h-8"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="16" cy="16" r="12" />

                    <path d="m10.5 16 3.5 3.5 7.5-8" />

                </svg>

            </div>

            <div>

                <div class="font-semibold text-gray-900">
                    Preview before submitting
                </div>

                <div class="mt-1 text-sm leading-5 text-gray-500">
                    Make sure it is perfect.
                </div>

            </div>

        </div>

    </section>

</div>